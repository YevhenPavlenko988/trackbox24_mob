<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: HTTPS only. The debug build overrides this file to allow http:// for a LAN backend. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
